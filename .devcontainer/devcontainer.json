{
  "name": "LowDevOps",
  "build": { "dockerfile": "Dockerfile" },
  "remoteUser": "vscode",
  // Terraform authenticates with the host's az login; the app never stores credentials.
  "mounts": ["source=${localEnv:HOME}/.azure,target=/home/vscode/.azure,type=bind"],
  "remoteEnv": { "ARM_USE_CLI": "true" },
  "forwardPorts": [5173, 8000],
  "postCreateCommand": "make install && cd frontend && npx playwright install --with-deps chromium",
  "customizations": {
    "vscode": {
      "extensions": [
        "charliermarsh.ruff",
        "ms-python.mypy-type-checker",
        "dbaeumer.vscode-eslint",
        "hashicorp.terraform",
        "ms-playwright.playwright"
      ]
    }
  }
}
